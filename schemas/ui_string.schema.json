{
  "$defs": {
    "ComponentType": {
      "description": "Supported component categories.",
      "enum": [
        "button",
        "field_label",
        "tooltip",
        "error_warning",
        "onboarding_empty_state"
      ],
      "title": "ComponentType",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "Original string and its source context, without editorial changes.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "string_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
      "title": "String Id",
      "type": "string"
    },
    "component_type": {
      "$ref": "#/$defs/ComponentType"
    },
    "original_text": {
      "maxLength": 100000,
      "minLength": 1,
      "title": "Original Text",
      "type": "string"
    },
    "context": {
      "maxLength": 100000,
      "minLength": 1,
      "title": "Context",
      "type": "string"
    },
    "screen_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Screen Id"
    },
    "product_area": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Area"
    },
    "user_goal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Goal"
    },
    "max_chars": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Chars"
    },
    "product_behavior": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Behavior"
    },
    "design_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Design Notes"
    },
    "protected_tokens": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Protected Tokens",
      "type": "array"
    },
    "source_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Reference"
    }
  },
  "required": [
    "string_id",
    "component_type",
    "original_text",
    "context"
  ],
  "title": "UIString",
  "type": "object"
}
